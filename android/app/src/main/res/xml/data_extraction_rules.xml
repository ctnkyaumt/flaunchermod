<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later; same exclusions as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="adb_private.key" />
        <exclude domain="file" path="adb_certificate.pem" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb_private.key" />
        <exclude domain="file" path="adb_certificate.pem" />
    </device-transfer>
</data-extraction-rules>
